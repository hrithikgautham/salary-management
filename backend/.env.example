# Supabase PostgreSQL connection string. Use a server-only database password.
SPRING_DATASOURCE_URL=jdbc:postgresql://db.vzzhlhkmaabmmjvhwgeh.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-your-database-password

# Must match the Supabase Auth issuer for the target project.
SUPABASE_ISSUER_URI=https://vzzhlhkmaabmmjvhwgeh.supabase.co/auth/v1
SUPABASE_JWK_SET_URI=https://vzzhlhkmaabmmjvhwgeh.supabase.co/auth/v1/.well-known/jwks.json
# Comma-separated Supabase user emails allowed to use the HR API
SUPABASE_ALLOWED_HR_EMAILS=your-hr-email@example.com
# Comma-separated exact frontend origin(s), no trailing slash.
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
SERVER_PORT=8080
